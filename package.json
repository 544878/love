{
  "name": "lovelog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "android:init": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@paddleocr/paddleocr-js": "^0.3.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
